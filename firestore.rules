service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "unithin57@gmail.com" && request.auth.token.email_verified == true));
    }

    // Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'dailyCalorieGoal']) &&
             data.uid is string &&
             data.email is string &&
             data.dailyCalorieGoal is number &&
             data.dailyCalorieGoal > 0 &&
             data.dailyCalorieGoal < 10000 &&
             (!('height' in data) || data.height == null || data.height is number) &&
             (!('weight' in data) || data.weight == null || data.weight is number) &&
             (!('age' in data) || data.age == null || data.age is number) &&
             (!('phoneNumber' in data) || data.phoneNumber is string);
    }

    function isValidMealLog(data) {
      return data.keys().hasAll(['userId', 'foodName', 'calories', 'mealType', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.foodName is string && data.foodName.size() > 0 && data.foodName.size() < 100 &&
             data.calories is int && data.calories >= 0 && data.calories < 5000 &&
             (!('protein' in data) || data.protein is int) &&
             (!('carbs' in data) || data.carbs is int) &&
             (!('fat' in data) || data.fat is int) &&
             (!('imageUrl' in data) || data.imageUrl is string) &&
             data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'] &&
             data.timestamp is string;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'text', 'sender', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() < 2000 &&
             data.sender in ['user', 'ai'] &&
             data.timestamp is string;
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
    }

    match /meals/{mealId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidMealLog(request.resource.data);
      allow update: if isDocOwner() && isValidMealLog(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /chats/{chatId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidChatMessage(request.resource.data);
      allow delete: if isDocOwner();
    }
  }
}
